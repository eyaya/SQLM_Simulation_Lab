# Frontend build-time configuration (Vite).
#
# Vite inlines every VITE_* variable into the bundle AT BUILD TIME. Changing one
# therefore requires a rebuild — restarting a server will not pick it up.
#
# ---------------------------------------------------------------------------
# PRODUCTION (Vercel)
# ---------------------------------------------------------------------------
# Do not commit a real .env file. Set this in the Vercel dashboard under
#   Project -> Settings -> Environment Variables
# ticked for Production, Preview AND Development, then redeploy with
# "Use existing Build Cache" UNCHECKED.
#
# The API origin. No trailing slash, no quotes.
VITE_API_BASE_URL=https://sqlm-api.onrender.com

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT
# ---------------------------------------------------------------------------
# Copy this file to frontend/.env.local and leave the value EMPTY. An empty
# value makes the client call its own origin, which the Vite dev server proxies
# to 127.0.0.1:8000 (see vite.config.js), and which nginx proxies in Docker.
#
# VITE_API_BASE_URL=
