# Production environment for the Render web service "sqlm-api".
#   https://sqlm-api.onrender.com
#
# This file documents the deployed configuration; Render does not read it.
# Most of these are already declared in render.yaml and are applied
# automatically when the Blueprint is synced. The two marked MUST SET BY HAND
# are declared there as `sync: false`, so Render deliberately leaves them empty
# for you to fill in the dashboard:
#   Render -> sqlm-api -> Environment
#
# ---------------------------------------------------------------------------
# MUST SET BY HAND  (render.yaml leaves these blank)
# ---------------------------------------------------------------------------

# Exact browser origins allowed to call the API, comma-separated.
#
# NO TRAILING SLASH. A browser's Origin header is scheme://host[:port] and
# never carries a path, so "https://sqlm-simulation-lab.vercel.app/" matches
# nothing and every request is refused. Add any custom domain here too.
SQLM_CORS_ORIGINS=https://sqlm-simulation-lab.vercel.app

# Optional. Only needed if Vercel PREVIEW deployments should reach the API.
# Previews get a generated hostname per branch, so they cannot be listed
# exactly. Anchored to this project's prefix on purpose — a loose pattern such
# as https://.*\.vercel\.app would let any Vercel-hosted site call your API.
# Leave empty if previews do not need API access.
SQLM_CORS_ORIGIN_REGEX=https://sqlm-simulation-lab-[a-z0-9-]+\.vercel\.app

# ---------------------------------------------------------------------------
# Applied automatically from render.yaml
# ---------------------------------------------------------------------------

# Concurrent studies. Each worker is a separate ~250 MB numpy/scipy/matplotlib
# process, so this is bounded by instance RAM as much as by CPU.
# Standard (2 GB / 1 CPU): 2.   Starter (512 MB / 0.5 CPU): 1.
UVICORN_WORKERS=2

# Render's filesystem is ephemeral: exported PNGs are discarded on every
# restart, redeploy and spin-down, and nothing serves them. The UI plots
# client-side from the JSON response, so this loses nothing and saves ~0.5s
# per request. Keep figure export for local Docker runs instead.
SQLM_WRITE_FIGURES=false

# The solver's matrices are small; threaded BLAS oversubscribes and slows
# things down. Measured locally: 21.7s -> 10.9s for the default study.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1

SQLM_LOG_LEVEL=INFO

# Ceilings on the solver knobs that drive request runtime. The API has no
# authentication, so without these an anonymous caller can pin a worker for
# hours. Tighter than the local defaults (201 / 500) on purpose.
SQLM_MAX_N=81
SQLM_MAX_MS=200

# ---------------------------------------------------------------------------
# Set by the platform — do not define these yourself
# ---------------------------------------------------------------------------
# PORT             Render injects this; the container binds to it.
# SQLM_OUTPUT_DIR  Irrelevant while SQLM_WRITE_FIGURES=false.
