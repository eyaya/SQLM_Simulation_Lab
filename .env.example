# Copy to .env and adjust as needed: cp .env.example .env

# Host port the web UI is published on.
FRONTEND_PORT=8080

# Uvicorn worker processes. Each one is a full numpy/scipy/matplotlib
# process (~250 MB), and each can run one study at a time.
UVICORN_WORKERS=2

# Ownership of files written into ./ep_results. Use your own: id -u / id -g
UID=1000
GID=1000

# Extra browser origins allowed to call the API directly on port 8000.
# Requests that go through the nginx proxy are same-origin and unaffected.
SQLM_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Leave empty to call the frontend's own origin (the nginx proxy).
VITE_API_BASE_URL=

# Regex for origins that cannot be listed exactly, such as Vercel preview
# deployments. Example: https://sqlm-[a-z0-9-]+\.vercel\.app
SQLM_CORS_ORIGIN_REGEX=

# Write study figures to SQLM_OUTPUT_DIR. Turn off on hosts with an ephemeral
# filesystem: the UI plots client-side and never reads these files.
SQLM_WRITE_FIGURES=true

SQLM_LOG_LEVEL=INFO

# Ceilings on the solver knobs that drive request runtime. Lower them on a
# public deployment; raise them for heavy local runs.
SQLM_MAX_N=201
SQLM_MAX_MS=500
